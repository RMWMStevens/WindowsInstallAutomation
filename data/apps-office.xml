<Configuration>
  <!--
    Microsoft 365 with Word, Excel and PowerPoint only, for the Office
    Deployment Tool (see data\apps-install.psd1), in the language Windows uses, plus
    Dutch. Menus stay in the language Windows uses. Only
    used for a new install: Setup leaves any Office that is already there
    alone, and never installs it on a work PC. O365HomePremRetail is for a
    Family or Personal licence; for a work or school account Setup asks, and
    uses a copy with O365ProPlusRetail (enterprise and school plans).
    ExcludeApp IDs:
    https://learn.microsoft.com/microsoft-365-apps/deploy/office-deployment-tool-configuration-options
  -->
  <Add OfficeClientEdition="64" Channel="Current">
    <Product ID="O365HomePremRetail">
      <Language ID="MatchOS" Fallback="en-us" />
      <Language ID="nl-nl" />
      <ExcludeApp ID="Access" />
      <ExcludeApp ID="OneNote" />
      <ExcludeApp ID="Publisher" />
      <ExcludeApp ID="Outlook" />            <!-- classic Outlook -->
      <ExcludeApp ID="OutlookForWindows" />  <!-- the new Outlook -->
      <ExcludeApp ID="Lync" />               <!-- Skype for Business -->
      <ExcludeApp ID="Teams" />
      <ExcludeApp ID="Groove" />             <!-- OneDrive, per Microsoft -->
      <ExcludeApp ID="OneDrive" />
    </Product>
  </Add>
  <Updates Enabled="TRUE" Channel="Current" />
  <Display Level="None" AcceptEULA="TRUE" />
</Configuration>
