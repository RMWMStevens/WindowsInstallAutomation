<Configuration>
  <!--
    Microsoft 365 with Word, Excel and PowerPoint only, for the Office
    Deployment Tool (see data\apps.psd1). Only used for a new install: Setup
    skips Office when it is already there. For a Personal or Family licence,
    use O365HomePremRetail. ExcludeApp IDs:
    https://learn.microsoft.com/microsoft-365-apps/deploy/office-deployment-tool-configuration-options
  -->
  <Add OfficeClientEdition="64" Channel="Current">
    <Product ID="O365ProPlusRetail">
      <Language ID="en-us" />
      <Language ID="nl-nl" />
      <ExcludeApp ID="Access" />
      <ExcludeApp ID="OneNote" />
      <ExcludeApp ID="Publisher" />
      <ExcludeApp ID="Outlook" />            <!-- classic Outlook -->
      <ExcludeApp ID="OutlookForWindows" />  <!-- the new Outlook -->
      <ExcludeApp ID="Lync" />               <!-- Skype for Business -->
      <ExcludeApp ID="Teams" />
      <ExcludeApp ID="Groove" />             <!-- OneDrive, per Microsoft -->
      <ExcludeApp ID="OneDrive" />
    </Product>
  </Add>
  <Updates Enabled="TRUE" Channel="Current" />
  <Display Level="None" AcceptEULA="TRUE" />
</Configuration>
