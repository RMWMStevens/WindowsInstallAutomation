<Configuration>
  <!--
    Office Deployment Tool configuration, used by the 'Microsoft 365' entry in
    data\apps.psd1 (setup.exe /configure office.xml).

    Installs only Word, Excel and PowerPoint. Everything else Microsoft 365
    Apps would bring along is excluded below, both Outlooks included.
    (No double hyphens in these comments: XML does not allow them.)

    Product O365ProPlusRetail = Microsoft 365 Apps, the same product winget's
    Microsoft.Office installs. For a Microsoft 365 Personal / Family licence use
    O365HomePremRetail instead.

    ExcludeApp IDs: https://learn.microsoft.com/microsoft-365-apps/deploy/office-deployment-tool-configuration-options
    This only shapes a new install. Setup skips Office when it is already there,
    so an existing install keeps whatever apps it has.
  -->
  <Add OfficeClientEdition="64" Channel="Current">
    <Product ID="O365ProPlusRetail">
      <Language ID="en-us" />
      <Language ID="nl-nl" />
      <ExcludeApp ID="Access" />
      <ExcludeApp ID="OneNote" />
      <ExcludeApp ID="Publisher" />
      <ExcludeApp ID="Outlook" />            <!-- classic Outlook -->
      <ExcludeApp ID="OutlookForWindows" />  <!-- the new Outlook -->
      <ExcludeApp ID="Lync" />               <!-- Skype for Business -->
      <ExcludeApp ID="Teams" />
      <!-- OneDrive: Microsoft says to use Groove; OneDrive is excluded too to be sure.
           data\remove.psd1 removes both OneDrive and Teams as well. -->
      <ExcludeApp ID="Groove" />
      <ExcludeApp ID="OneDrive" />
    </Product>
  </Add>
  <Updates Enabled="TRUE" Channel="Current" />
  <Display Level="None" AcceptEULA="TRUE" />
</Configuration>
